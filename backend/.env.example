APP_NAME=Kritique
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
GITHUB_SECRET=replace-with-webhook-secret
GITHUB_TOKEN=replace-with-github-token-for-webhook-reviews
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app
GROQ_API_KEY=replace-with-groq-api-key
REDIS_URL=
DEBUG_SQL=false
REVIEW_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
MAX_CONCURRENT_LLM_CALLS=4
MAX_PATCH_CHARS=200000
REVIEW_FILE_PATTERNS=*.lock,package-lock.json,pnpm-lock.yaml,yarn.lock,poetry.lock,uv.lock,*.lockb,*.min.js,*.min.css,*.map,*.png,*.jpg,*.jpeg,*.gif,*.webp,*.ico,*.pdf,*.svg,*.woff,*.woff2,*.ttf,*.eot,vendor/**,dist/**,build/**,generated/**
SECURITY_SCORE_WEIGHT=0.40
STYLE_SCORE_WEIGHT=0.25
ARCHITECTURE_SCORE_WEIGHT=0.35
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=0.5
LLM_RETRY_MAX_SECONDS=8
LLM_RETRY_JITTER_SECONDS=0.25
REVIEW_INPUT_USD_PER_MILLION=0.15
REVIEW_OUTPUT_USD_PER_MILLION=0.60
CORS_ORIGINS=http://localhost:3000,https://kritique-three.vercel.app
